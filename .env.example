# Atlas Supabase project configuration
SUPABASE_PROJECT_REF=bjdjjgnkhxblnpdrjqtw
SUPABASE_URL=https://bjdjjgnkhxblnpdrjqtw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-atlas-service-role-key

# Required only for applying SQL/exporting schema through the Supabase Management API.
SUPABASE_MANAGEMENT_PAT=replace-with-management-pat

# Atlas Express service
PORT=8787
ATLAS_API_BASE_URL=http://localhost:8787
DEFAULT_CURSOR_CREATED_BY=atlas-local

# ── Adapter API Keys ──
# Most adapters work without keys (free public APIs), but keys increase rate limits.

# Existing adapters
OPENSTATES_API_KEY=
COURTLISTENER_API_KEY=
GRANTS_GOV_API_KEY=
PROPUBLICA_API_KEY=

# Backbone/civic data
CENSUS_API_KEY=
ACS_YEAR=2022
HUD_API_KEY=
BLS_API_KEY=
REGULATIONS_GOV_API_KEY=

# Follow the money / corruption
FEC_API_KEY=DEMO_KEY
OPENSECRETS_API_KEY=
SEC_USER_AGENT=AtlasStreamingEngine/1.0 (atlas@luminari.app)

# No key needed:
# - USDA SNAP (ArcGIS public)
# - USAspending.gov (open API)
# - CFPB complaints (open API)
# - EPA ECHO (open API)
# - OSHA/DOL (open API)
# - FARA (DOJ public)
# - SEC EDGAR (just needs User-Agent)
